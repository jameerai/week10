import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Counter App',
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepPurple),
        useMaterial3: true,
      ),
      home: const CounterPage(),
    );
  }
}

class CounterPage extends StatefulWidget {
  const CounterPage({super.key});

  @override
  State<CounterPage> createState() => _CounterPageState();
}

class _CounterPageState extends State<CounterPage> {
  int _counter = 0;

  // FIX 1: Properly update state using setState()
  void _incrementCounter() {
    setState(() {
      _counter++;
    });
  }

  // FIX 2: Ensure counter never goes below zero
  void _decrementCounter() {
    setState(() {
      if (_counter > 0) {
        _counter--;
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Debuggable Counter App'),
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: <Widget>[
            const Text(
              'Current Value:',
              style: TextStyle(fontSize: 18),
            ),
            const SizedBox(height: 10),
            // FIX 3: Prevent layout overflow using FittedBox and Constraints
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16.0),
              child: Container(
                padding: const EdgeInsets.all(12.0),
                decoration: BoxDecoration(
                  border: Border.all(color: Colors.deepPurple, width: 2),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Flexible(
                      child: FittedBox(
                        fit: BoxFit.scaleDown,
                        child: Text(
                          'Count: $_counter',
                          style: Theme.of(context).textTheme.headlineMedium,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 20),
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                // Decrement Button
                FloatingActionButton(
                  key: const Key('decrement_button'),
                  onPressed: _decrementCounter,
                  tooltip: 'Decrement',
                  child: const Icon(Icons.remove),
                ),
                const SizedBox(width: 20),
                // Increment Button (FIX 4: Correctly assign callback)
                FloatingActionButton(
                  key: const Key('increment_button'),
                  onPressed: _incrementCounter,
                  tooltip: 'Increment',
                  child: const Icon(Icons.add),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:counter_app/main.dart'; // Adjust import based on project name

void main() {
  group('Counter App Widget Tests', () {
    // Task 1: Verify Initial Counter Value
    testWidgets('Initial counter value is 0', (WidgetTester tester) async {
      await tester.pumpWidget(const MyApp());

      expect(find.text('Count: 0'), findsOneWidget);
      expect(find.text('Count: 1'), findsNothing);
    });

    // Task 2: Verify Increment Functionality
    testWidgets('Tapping the increment button increases the counter by 1',
        (WidgetTester tester) async {
      await tester.pumpWidget(const MyApp());

      // Tap increment button
      await tester.tap(find.byKey(const Key('increment_button')));
      await tester.pump();

      // Verify incremented count
      expect(find.text('Count: 1'), findsOneWidget);
      expect(find.text('Count: 0'), findsNothing);
    });

    // Task 3: Verify Decrement Functionality
    testWidgets('Tapping the decrement button decreases the counter by 1',
        (WidgetTester tester) async {
      await tester.pumpWidget(const MyApp());

      // Increment first to reach 1
      await tester.tap(find.byKey(const Key('increment_button')));
      await tester.pump();
      expect(find.text('Count: 1'), findsOneWidget);

      // Tap decrement button
      await tester.tap(find.byKey(const Key('decrement_button')));
      await tester.pump();

      // Verify decremented count
      expect(find.text('Count: 0'), findsOneWidget);
    });

    // Task 4: Prevent Negative Counter Values
    testWidgets('Counter value never goes below 0',
        (WidgetTester tester) async {
      await tester.pumpWidget(const MyApp());

      // Attempt decrementing at 0
      await tester.tap(find.byKey(const Key('decrement_button')));
      await tester.pump();

      // Counter should remain 0
      expect(find.text('Count: 0'), findsOneWidget);
      expect(find.text('Count: -1'), findsNothing);
    });

    // Task 5: Verify Counter Text Rendering and Layout Rendering
    testWidgets('Counter text is displayed correctly on screen without overflow',
        (WidgetTester tester) async {
      await tester.pumpWidget(const MyApp());

      // Increment up to 10+ to test layout resilience
      for (int i = 0; i < 12; i++) {
        await tester.tap(find.byKey(const Key('increment_button')));
        await tester.pump();
      }

      expect(find.text('Count: 12'), findsOneWidget);
      expect(tester.takeException(), isNull); // Ensures no overflow exception thrown
    });
  });
}
